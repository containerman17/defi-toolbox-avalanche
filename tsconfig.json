{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "pool-collector/**/*.ts",
    "router/**/*.ts",
    "examples/**/*.ts",
    "utils/**/*.ts",
    "rpc/**/*.ts"
  ]
}
