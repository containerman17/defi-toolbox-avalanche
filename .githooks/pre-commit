#!/bin/bash
if ! git diff --cached --name-only | grep -q '^CHANGELOG.md$'; then
  echo "Every commit should be recorded in the changelog."
  exit 1
fi

# Block commits if benchmark detected overquotes
PREC_FILE="benchmarks/formula-accuracy/precision.txt"
if [ -f "$PREC_FILE" ]; then
  OVER=$(grep -oP 'overquotes=\K[0-9]+' "$PREC_FILE")
  if [ -n "$OVER" ] && [ "$OVER" -gt 0 ]; then
    echo ""
    echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
    echo "!!! COMMIT BLOCKED: $OVER overquotes detected               !!!"
    echo "!!! Formula must NEVER return more than EVM.                !!!"
    echo "!!! Fix the formula or set the pool to -1 in registry.txt  !!!"
    echo "!!! Then re-run: go run ./benchmarks/formula-accuracy/      !!!"
    echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
    exit 1
  fi
fi
